---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getClusterGroups, getPatterns, getRelatedMap } from '../lib/patterns';
import { journeys } from '../data/journeys';

const [patterns, groups, relatedMap] = await Promise.all([getPatterns(), getClusterGroups(), getRelatedMap()]);
const byId = new Map(patterns.map((p) => [p.id, p]));
for (const journey of journeys) {
  for (const id of journey.steps) {
    if (!byId.has(id)) throw new Error(`Journey "${journey.title}" refers to unknown pattern "${id}"`);
  }
}
---
<BaseLayout title="Journeys" description="Everyday situations and the patterns that help, in the order you'd use them">
  <h1>Journeys</h1>
  <p class="lead">
    Real situations involve several problems in a row. Each journey takes one everyday situation and lists the
    patterns that help, in the order you'd use them.
  </p>

  <section>
    <div class="journeys">
      {journeys.map((journey) => (
        <article class="journey">
          <h3>{journey.title}</h3>
          <p>{journey.intro}</p>
          <ol>
            {journey.steps.map((id) => {
              const p = byId.get(id)!;
              return (
                <li>
                  <a href={url(`/patterns/${p.id}/`)}>{p.data.title}</a>
                  <span class="pattern-type">{p.data.type}</span>
                </li>
              );
            })}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2>All patterns and their connections</h2>
    {groups.map(({ cluster, patterns: members }) => (
      <div class="area">
        <h3><a href={url(`/patterns/clusters/${cluster.id}/`)}>{cluster.data.title}</a></h3>
        <dl>
          {members.map((p) => (
            <>
              <dt><a href={url(`/patterns/${p.id}/`)}>{p.data.title}</a></dt>
              <dd>
                {(relatedMap.get(p.id) ?? []).map((r, i) => (
                  <>{i > 0 && ' · '}<a href={url(`/patterns/${r.id}/`)}>{r.data.title}</a></>
                ))}
              </dd>
            </>
          ))}
        </dl>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  section { margin-top: 2rem; }
  section > h2 { font-size: 1.4rem; }
  .journeys {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }
  .journey {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.1rem 1.25rem;
  }
  .journey h3 { font-size: 1.05rem; margin-bottom: 0.35rem; }
  .journey p { color: var(--color-muted); font-size: 0.9rem; margin-bottom: 0.75rem; }
  .journey ol { margin: 0; padding-left: 1.25rem; }
  .journey li { margin-bottom: 0.35rem; }
  .journey li a { margin-right: 0.4rem; }
  .area { margin-top: 1.75rem; }
  .area h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .area h3 a { color: var(--color-text); }
  dl { margin: 0; }
  dt { font-weight: 600; margin-top: 0.75rem; }
  dd { margin: 0.15rem 0 0; font-size: 0.85rem; color: var(--color-muted); }
  dd a { color: var(--color-muted); text-decoration: underline; text-decoration-color: var(--color-border); text-underline-offset: 2px; }
  dd a:hover { color: var(--color-accent); }
</style>
