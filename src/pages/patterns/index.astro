---
import { url } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PatternList from '../../components/PatternList.astro';
import Search from '../../components/Search.astro';
import { getClusterGroups } from '../../lib/patterns';

const groups = await getClusterGroups();
---
<BaseLayout title="Patterns" description="The Pattern Life library, grouped by life area">
  <div class="page-title-row">
    <h1>Patterns</h1>
    <a href={url('/patterns/rss.xml')} class="rss-link" title="Subscribe via RSS" aria-label="Subscribe to the patterns RSS feed">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="6.18" cy="17.82" r="2.18"></circle>
        <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"></path>
      </svg>
    </a>
  </div>
  <Search />
  <p class="page-intro">
    Each pattern describes a recurring problem from everyday life and a solution that reliably works. Patterns are
    grouped into life areas and classified into six types: <strong>Technique</strong> (a concrete way of doing
    something), <strong>Process</strong> (an order of work or routine for a recurring task),
    <strong>Preparation</strong> (what to plan, check or bring beforehand), <strong>Safety</strong>
    (avoiding harm to people or things), <strong>Etiquette</strong> (sharing spaces and getting along with others) and
    <strong>Recipe</strong> (applying several general patterns to one dish, and saying what's specific to it).
    Have an idea for a pattern? <a href={url('/contribute/')}>Suggest one</a>.
  </p>

  {groups.map(({ cluster, patterns }) => (
    <section class="cluster-group">
      <h2>
        <a href={url(`/patterns/clusters/${cluster.id}/`)}>
          {cluster.data.title}<span class="cluster-arrow" aria-hidden="true">→</span>
        </a>
      </h2>
      <PatternList patterns={patterns} />
    </section>
  ))}
</BaseLayout>

<style>
  .page-title-row { display: flex; justify-content: space-between; align-items: baseline; }
  .rss-link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding: 0.25rem 0.4rem;
    line-height: 1;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  .rss-link:hover { color: var(--color-accent); border-color: var(--color-accent); text-decoration: none; }
  .cluster-group { margin-bottom: 2.5rem; }
  .cluster-group:first-of-type { margin-top: 2rem; }
  .cluster-group h2 { font-size: 1.3rem; margin-bottom: 0.25rem; }
  .cluster-group h2 a { text-decoration: none; }
  .cluster-arrow { display: inline-block; margin-left: 0.4em; font-size: 0.85em; transition: transform 0.12s ease-out; }
  .cluster-group h2 a:hover .cluster-arrow { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    .cluster-arrow { transition: none; }
  }
</style>
