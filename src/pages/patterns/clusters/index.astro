---
import { url } from '../../../lib/url';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getClusterGroups } from '../../../lib/patterns';

const groups = await getClusterGroups();
---
<BaseLayout title="Life areas" description="Pattern Life patterns grouped by area of life">
  <h1>Life areas</h1>
  <p class="lead">Patterns are grouped into areas of everyday life. Each area collects patterns that share a common set of problems.</p>
  <ul class="area-list">
    {groups.map(({ cluster, patterns }) => (
      <li>
        <a href={url(`/patterns/clusters/${cluster.id}/`)} class="area-title">{cluster.data.title}</a>
        <span class="area-count">{patterns.length} {patterns.length === 1 ? 'pattern' : 'patterns'}</span>
        <p>{cluster.data.framing}</p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .area-list { list-style: none; margin: 0; padding: 0; }
  .area-list li { border-top: 1px solid var(--color-border); padding: 1.5rem 0; }
  .area-title { font-size: 1.2rem; font-weight: 600; font-family: var(--font-display); }
  .area-count { margin-left: 0.75rem; color: var(--color-muted); font-size: 0.85rem; }
  .area-list p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
