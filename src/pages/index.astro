---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getClusterGroups, getPatterns } from '../lib/patterns';

const groups = await getClusterGroups();
const latest = (await getPatterns())
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);
---
<BaseLayout>
  <h1 class="hero-title">Pattern Life</h1>
  <p class="lead">
    Practical, tested patterns for everyday life — from using kitchen gadgets to planning a day hike to
    parking in a busy city.
  </p>

  <section class="about">
    <h2>What is a pattern?</h2>
    <p>
      A pattern is a short, reusable description of a <strong>problem that keeps coming up</strong> and a
      <strong>solution that reliably works</strong>. The idea comes from architecture and software engineering,
      where patterns capture hard-won experience so others don't have to rediscover it. Pattern Life applies the
      same idea to ordinary life.
    </p>
    <p>
      Every pattern follows the same structure: the problem, when it applies, a summary with a table of
      recommendations and the reasons for them, the context it suits (and doesn't), how to do it, and references. That makes patterns quick to scan
      and easy to compare.
    </p>
    <p><a href={url('/patterns/')} class="cta">Browse the patterns →</a></p>
  </section>

  <section>
    <h2>Life areas</h2>
    <ul class="area-grid">
      {groups.map(({ cluster, patterns }) => (
        <li>
          <a href={url(`/patterns/clusters/${cluster.id}/`)}>
            <span class="area-name">{cluster.data.title}</span>
            <span class="area-count">{patterns.length} {patterns.length === 1 ? 'pattern' : 'patterns'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {latest.length > 0 && (
    <section>
      <h2>Recently added</h2>
      <ul class="latest">
        {latest.map((p) => (
          <li>
            <a href={url(`/patterns/${p.id}/`)}>{p.data.title}</a>
            <span class="pattern-type">{p.data.type}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .hero-title { font-size: 2.6rem; margin-bottom: 0.75rem; }
  section { margin-top: 2.5rem; }
  section h2 { font-size: 1.3rem; }
  .cta {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: 6px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-weight: 500;
  }
  .cta:hover { text-decoration: none; opacity: 0.9; }
  .area-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
  }
  .area-grid a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
  }
  .area-grid a:hover { border-color: var(--color-accent); text-decoration: none; }
  .area-name { font-weight: 600; }
  .area-count { color: var(--color-muted); font-size: 0.85rem; }
  .latest { list-style: none; margin: 0; padding: 0; }
  .latest li { display: flex; align-items: baseline; gap: 0.75rem; padding: 0.5rem 0; border-top: 1px solid var(--color-border); }
</style>
