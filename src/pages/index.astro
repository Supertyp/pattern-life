---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getClusterGroups, getPatterns, getRelatedMap } from '../lib/patterns';

const [patterns, groups, relatedMap] = await Promise.all([getPatterns(), getClusterGroups(), getRelatedMap()]);
const linkCount = [...relatedMap.values()].reduce((n, r) => n + r.length, 0) / 2;
const latest = [...patterns]
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);
---
<BaseLayout>
  <h1 class="hero-title">Pattern Life</h1>
  <p class="lead">
    Practical, tested patterns for everyday life — from using kitchen gadgets to planning a day hike to
    parking in a busy city.
  </p>

  <section class="about">
    <h2>What is a pattern?</h2>
    <p>
      A pattern is a short, reusable description of a <strong>problem that keeps coming up</strong> and a
      <strong>solution that reliably works</strong>. The idea comes from architecture and software engineering,
      where patterns capture hard-won experience so others don't have to rediscover it. Pattern Life applies the
      same idea to ordinary life.
    </p>
    <p>
      Every pattern follows the same structure: the problem, when it applies, a summary with a table of
      recommendations and the reasons for them, the context it suits (and doesn't), how to do it, and references. That makes patterns quick to scan
      and easy to compare.
    </p>
  </section>

  <section class="about">
    <h2>A pattern language</h2>
    <p>
      Together the patterns form a <strong>pattern language</strong>: {patterns.length} patterns
      across {groups.length} areas of life, joined by {linkCount} links. A single pattern solves a single problem, but real
      situations involve several problems in a row: cooking dinner means preparing, cutting, cooking, storing and
      cleaning up. The patterns are written to fit together, and each one points to its neighbours instead of
      repeating them.
    </p>
    <ul>
      <li><strong>Start from a situation.</strong> Pick one of the <a href={url('/journeys/')}>journeys</a> and work through its patterns in order.</li>
      <li><strong>Start from a problem.</strong> Search the <a href={url('/patterns/')}>pattern library</a>, read the problem and the "Applies when" list, and check it matches your situation.</li>
      <li><strong>Follow the links.</strong> Every pattern ends with its related patterns. Following them is how you find the next useful habit.</li>
      <li><strong>Adapt it.</strong> Each pattern names a trade-off. If your circumstances differ, make the other choice deliberately.</li>
      <li><strong>Make it a habit.</strong> Pick one pattern, practise it for a week or two until it's automatic, then add the next.</li>
    </ul>
    <p class="cta-row">
      <a href={url('/journeys/')} class="cta">Start with a journey →</a>
      <a href={url('/patterns/')} class="cta-secondary">Browse all patterns</a>
    </p>
  </section>

  <section>
    <h2>Life areas</h2>
    <ul class="area-grid">
      {groups.map(({ cluster, patterns }) => (
        <li>
          <a href={url(`/patterns/clusters/${cluster.id}/`)}>
            <span class="area-name">{cluster.data.title}</span>
            <span class="area-count">{patterns.length} {patterns.length === 1 ? 'pattern' : 'patterns'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {latest.length > 0 && (
    <section>
      <h2>Recently added</h2>
      <ul class="latest">
        {latest.map((p) => (
          <li>
            <a href={url(`/patterns/${p.id}/`)}>{p.data.title}</a>
            <span class="pattern-type">{p.data.type}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .hero-title { font-size: 2.6rem; margin-bottom: 0.75rem; }
  section { margin-top: 2.5rem; }
  section h2 { font-size: 1.3rem; }
  .cta {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: 6px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-weight: 500;
  }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; }
  .cta-secondary { margin-top: 0.5rem; font-weight: 500; }
  .cta:hover { text-decoration: none; opacity: 0.9; }
  .area-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
  }
  .area-grid a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
  }
  .area-grid a:hover { border-color: var(--color-accent); text-decoration: none; }
  .area-name { font-weight: 600; }
  .area-count { color: var(--color-muted); font-size: 0.85rem; }
  .about ul { padding-left: 1.25rem; }
  .about li { margin-bottom: 0.4rem; }
  .latest { list-style: none; margin: 0; padding: 0; }
  .latest li { display: flex; align-items: baseline; gap: 0.75rem; padding: 0.5rem 0; border-top: 1px solid var(--color-border); }
</style>
